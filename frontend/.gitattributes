# =============================================================================
# .gitattributes — controla como o Git trata os arquivos ao fazer commit
# =============================================================================
# Garante que os fins de linha dos arquivos do frontend sejam consistentes
# em qualquer sistema operacional (Linux, Mac ou Windows).
# =============================================================================

# --- Texto padrão: LF ---
* text=auto eol=lf

# --- Arquivos de configuração do Node/Vite ---
*.json     text eol=lf
*.ts       text eol=lf
*.tsx      text eol=lf
*.css      text eol=lf
*.html     text eol=lf
*.md       text eol=lf

# --- Binários ---
*.png      binary
*.svg      binary
*.ico      binary
